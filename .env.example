# ============================================================================
# Fyers API v3 credentials — KEEP THESE SECRET. Never commit the real .env.
# ============================================================================

# App credentials from https://myapi.fyers.in/dashboard/
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=

# Your login credentials (used only for the automated daily TOTP login flow)
FYERS_FY_ID=
FYERS_USER_PIN=
FYERS_TOTP_SECRET=

# Must exactly match the redirect URL registered in the Fyers app dashboard
FYERS_REDIRECT_URI=https://127.0.0.1:8000/callback

# ---- Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Gemini AI Pre-Market Intelligence ----
GEMINI_API_KEY=

# ---- CLI tuning (optional) ----
# Set to "true" to force the trader to run outside market hours (dev/testing)
FORCE_MARKET_OPEN=false

# ============================================================================
# Web backend (backend/) — see docs/ARCHITECTURE.md
# ============================================================================

# Set to "true" to have THIS instance hold the one allowed Fyers WebSocket connection and run
# live. Leave "false" to run in replay mode (loops data/historical/nifty_90days.csv) — e.g. for
# local dev, or when another instance (this repo's or a sibling project's) already holds it.
DATA_ENGINE_ENABLED=false
INSTANCE_NAME=local

# Frontend origin(s) allowed by CORS, comma separated (dev default matches `npm run dev`)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WebSocket push cadence in seconds
STREAM_INTERVAL=1.0
PORT=8001

# Signs the session cookie that bridges Supabase-JWT login to the WebSocket (which can't carry a
# custom Authorization header). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Dashboard login is Supabase Auth — verification uses Supabase's public JWKS endpoint, so only
# the project URL is needed here (no secret). Direct Postgres connection (transaction-pooler,
# port 6543) for paper-trading persistence — see backend/migrations/001_options_positions.sql.
SUPABASE_URL=
SUPABASE_DB_URL=
